---
import LayoutBlog from "../../layouts/LayoutBlog.astro";
import PostPreview from "../../components/blog/PostPreview.astro";
import BlogFeatured from "../../components/blog/BlogFeatured.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../../config/site";

const posts = await getCollection("blog");
// Get all posts except the featured one (por-que-escolher-astro.md)
const regularPosts = posts.filter(
  (post) => post.id !== "por-que-escolher-astro.md"
);
const sortedPosts = regularPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<LayoutBlog title={`Blog - ${siteConfig.title}`}>
  <div class="px-4 sm:px-6 lg:px-8 py-8" x-data="blogSearch()" x-init="init()">
    <header class="mb-12 text-center">
      <h1 class="text-5xl font-bold text-gray-800 dark:text-gray-100 mb-6">
        Blog
      </h1>
      <p class="text-xl text-gray-700 dark:text-gray-200 max-w-2xl mx-auto">
        Compartilhando conhecimento, experiências e aprendizados sobre
        desenvolvimento web.
      </p>

      <!-- Search Component -->
      <div class="mt-8 max-w-md mx-auto">
        <div class="relative">
          <input
            type="text"
            x-model="query"
            @input="search()"
            placeholder="Buscar posts..."
            class="w-full px-4 py-3 pl-12 pr-4 text-gray-900 dark:text-gray-100 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
          />
          <div
            class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
          >
            <svg
              class="h-5 w-5 text-gray-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <button
            x-show="query.length > 0"
            @click="clearSearch()"
            class="absolute inset-y-0 right-0 pr-3 flex items-center"
          >
            <svg
              class="h-5 w-5 text-gray-400 hover:text-gray-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Search Results Counter -->
        <div
          x-show="query.length > 0"
          class="mt-2 text-sm text-gray-600 dark:text-gray-400"
        >
          <span x-text="filteredPosts.length"></span>
          <span
            x-text="filteredPosts.length === 1 ? 'post encontrado' : 'posts encontrados'"
          ></span>
          <span x-show="query.length > 0"
            >para "<span x-text="query" class="font-medium"></span>"</span
          >
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto">
      <!-- Featured Post (always visible) -->
      <div class="mb-12" x-show="query.length === 0">
        <BlogFeatured />
      </div>

      <!-- Posts Grid - Show Alpine.js results when searching, otherwise show server-rendered posts -->
      <div x-show="query.length > 0">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <template x-for="post in filteredPosts" :key="post.slug">
            <article
              class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300"
            >
              <div class="p-6">
                <div
                  class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-3"
                >
                  <time x-text="formatDate(post.pubDate)"></time>
                  <span>•</span>
                  <div class="flex gap-2">
                    <template x-for="tag in post.tags" :key="tag">
                      <span
                        class="bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 px-2 py-1 rounded-full text-xs"
                        x-text="tag"></span>
                    </template>
                  </div>
                </div>

                <h2
                  class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-3"
                >
                  <a
                    :href="`/blog/${post.slug}`"
                    class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                    x-text="post.title"></a>
                </h2>

                <p
                  class="text-gray-600 dark:text-gray-300 mb-4 line-clamp-3"
                  x-text="post.description"
                >
                </p>

                <a
                  :href="`/blog/${post.slug}`"
                  class="inline-flex items-center text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium"
                >
                  Ler mais
                  <svg
                    class="ml-1 w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </article>
          </template>
        </div>
      </div>

      <!-- Server-rendered posts (when not searching) -->
      <div x-show="query.length === 0">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {
            sortedPosts.map((post) => (
              <PostPreview
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                tags={post.data.tags}
                slug={post.slug}
              />
            ))
          }
        </div>
      </div>

      <!-- No Results Message -->
      <div
        x-show="query.length > 0 && filteredPosts.length === 0"
        class="text-center py-12"
      >
        <div class="text-gray-400 mb-4">
          <svg
            class="mx-auto h-12 w-12"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <p class="text-gray-600 dark:text-gray-400 text-lg">
          Nenhum post encontrado para "<span x-text="query" class="font-medium"
          ></span>"
        </p>
        <p class="text-gray-500 dark:text-gray-500 text-sm mt-2">
          Tente buscar por outros termos ou navegue pelos posts abaixo.
        </p>
      </div>

      <!-- Empty State (when no posts exist) -->
      <div x-show="sortedPosts.length === 0" class="text-center py-12">
        <p class="text-gray-600 dark:text-gray-400">
          Nenhum post encontrado. Em breve teremos novos conteúdos!
        </p>
      </div>
    </div>
  </div>
</LayoutBlog>

<script
  define:vars={{
    posts: sortedPosts.map((post) => ({
      title: post.data.title,
      description: post.data.description,
      slug: post.slug,
      pubDate: post.data.pubDate.toISOString(),
      tags: post.data.tags || [],
    })),
  }}
>
  // Blog search functionality with Alpine.js
  document.addEventListener("alpine:init", () => {
    Alpine.data("blogSearch", () => ({
      query: "",
      allPosts: [],
      filteredPosts: [],

      init() {
        // Initialize posts data from server-side rendered data
        this.allPosts = posts;
        this.filteredPosts = [...this.allPosts];
        console.log(
          `Initialized blog search with ${this.allPosts.length} posts`
        );
      },

      search() {
        if (this.query.length === 0) {
          this.filteredPosts = [...this.allPosts];
          return;
        }

        const searchTerm = this.query.toLowerCase().trim();

        this.filteredPosts = this.allPosts.filter((post) => {
          // Search in title
          const titleMatch = post.title.toLowerCase().includes(searchTerm);

          // Search in description
          const descriptionMatch = post.description
            .toLowerCase()
            .includes(searchTerm);

          // Search in tags
          const tagsMatch = post.tags.some((tag) =>
            tag.toLowerCase().includes(searchTerm)
          );

          return titleMatch || descriptionMatch || tagsMatch;
        });

        console.log(
          `Search for "${searchTerm}" found ${this.filteredPosts.length} results`
        );
      },

      clearSearch() {
        this.query = "";
        this.filteredPosts = [...this.allPosts];
      },

      formatDate(dateString) {
        const date = new Date(dateString);
        return date.toLocaleDateString("pt-BR", {
          year: "numeric",
          month: "long",
          day: "numeric",
        });
      },
    }));
  });
</script>

<style>
  article {
    transition: transform 0.2s ease-in-out;
  }

  /* Line clamp utility for description truncation */
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Search input focus styles */
  .search-input:focus {
    outline: none;
    ring: 2px;
    ring-color: rgb(59 130 246);
    border-color: rgb(59 130 246);
  }

  /* Smooth transitions for search results */
  [x-cloak] {
    display: none !important;
  }
</style>
