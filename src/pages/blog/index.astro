---
import LayoutBlog from "../../layouts/LayoutBlog.astro";
import PostPreview from "../../components/blog/PostPreview.astro";
import BlogFeatured from "../../components/blog/BlogFeatured.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../../config/site";

const posts = await getCollection("blog");
const featuredSlug = "arquitetura-offline-first-sqlite-outbox";

// Exclui o post em destaque da lista geral
const regularPosts = posts.filter(
  (post) => post.slug !== featuredSlug && post.id !== `${featuredSlug}.md`
);
const sortedPosts = regularPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Extrai todas as tags únicas de todos os posts
const allTags = Array.from(
  new Set(posts.flatMap((p) => p.data.tags || []))
).sort();
---

<LayoutBlog title={`Blog - ${siteConfig.title}`}>
  <div class="px-4 sm:px-6 lg:px-8 py-8" x-data="blogSearch()" x-init="init()">
    <header class="mb-12 text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
        Blog & Artigos Técnicos
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        Explorações práticas sobre arquitetura de software, concorrência, sistemas distribuídos e engenharia de alta performance.
      </p>

      <!-- Search & Filters Container -->
      <div class="mt-8 max-w-2xl mx-auto">
        <!-- Campo de Busca -->
        <div class="relative max-w-md mx-auto">
          <input
            type="text"
            x-model="query"
            @input="search()"
            placeholder="Buscar por termos, tópicos..."
            class="w-full px-4 py-3 pl-12 pr-4 text-slate-900 dark:text-slate-100 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
          />
          <div
            class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
          >
            <svg
              class="h-5 w-5 text-slate-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <button
            x-show="query.length > 0"
            @click="clearSearch()"
            class="absolute inset-y-0 right-0 pr-3 flex items-center cursor-pointer"
          >
            <svg
              class="h-5 w-5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Tag Filter Pills -->
        <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
          <button
            type="button"
            @click="filterByTag('')"
            :class="selectedTag === '' ? 'bg-blue-600 text-white shadow-sm shadow-blue-500/25' : 'bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-700'"
            class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer"
          >
            #Todos
          </button>
          
          <template x-for="tag in allTagsList" :key="tag">
            <button
              type="button"
              @click="filterByTag(tag)"
              :class="selectedTag === tag ? 'bg-blue-600 text-white shadow-sm shadow-blue-500/25' : 'bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-700'"
              class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer"
              x-text="'#' + tag"
            >
            </button>
          </template>
        </div>

        <!-- Search & Filter Status Counter -->
        <div
          x-show="isFiltering"
          class="mt-4 text-sm text-slate-600 dark:text-slate-400 flex items-center justify-center gap-2"
        >
          <span>
            <strong x-text="filteredPosts.length"></strong>
            <span x-text="filteredPosts.length === 1 ? 'artigo encontrado' : 'artigos encontrados'"></span>
            <span x-show="selectedTag !== ''" x-text="' em #' + selectedTag"></span>
            <span x-show="query.length > 0" x-text="' para \"' + query + '\"'"></span>
          </span>
          <button
            @click="clearAllFilters()"
            class="text-xs text-blue-600 dark:text-blue-400 hover:underline font-semibold cursor-pointer"
          >
            (Limpar filtros)
          </button>
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto">
      <!-- Featured Post (visível quando não há nenhum filtro ativo) -->
      <div class="mb-12" x-show="!isFiltering">
        <BlogFeatured />
      </div>

      <!-- Posts Grid - Resultados dinâmicos quando há filtro ou busca ativa -->
      <div x-show="isFiltering">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <template x-for="post in filteredPosts" :key="post.slug">
            <article
              class="bg-white dark:bg-slate-800 rounded-xl shadow-md overflow-hidden border border-slate-200/80 dark:border-slate-700/80 hover:shadow-lg transition-all duration-300"
            >
              <div class="p-6">
                <div
                  class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-3"
                >
                  <time x-text="formatDate(post.pubDate)"></time>
                  <span x-show="post.readingTime">•</span>
                  <span x-show="post.readingTime" class="font-medium text-emerald-600 dark:text-emerald-400" x-text="'⏱️ ' + post.readingTime + ' min'"></span>
                  <span>•</span>
                  <div class="flex gap-1.5 flex-wrap">
                    <template x-for="tag in post.tags" :key="tag">
                      <button
                        type="button"
                        @click="filterByTag(tag)"
                        :class="selectedTag === tag ? 'bg-blue-600 text-white' : 'bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 border border-blue-200/50 dark:border-blue-800/50'"
                        class="px-2 py-0.5 rounded text-[11px] font-semibold hover:opacity-80 transition-opacity cursor-pointer"
                        x-text="'#' + tag"></button>
                    </template>
                  </div>
                </div>

                <h2
                  class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-3 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >
                  <a
                    :href="'/blog/' + post.slug"
                    x-text="post.title"></a>
                </h2>

                <p
                  class="text-slate-600 dark:text-slate-300 text-sm mb-4 line-clamp-3 leading-relaxed"
                  x-text="post.description"
                >
                </p>

                <a
                  :href="'/blog/' + post.slug"
                  class="inline-flex items-center text-sm font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300"
                >
                  Ler artigo completo
                  <svg
                    class="ml-1 w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </article>
          </template>
        </div>
      </div>

      <!-- Server-rendered posts (quando nenhum filtro está ativo) -->
      <div x-show="!isFiltering">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {
            sortedPosts.map((post) => {
              const words = (post.body || '').trim().split(/\s+/).filter(Boolean).length;
              const readingTime = Math.max(1, Math.ceil(words / 200));
              return (
                <PostPreview
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  tags={post.data.tags}
                  slug={post.slug}
                  readingTime={readingTime}
                />
              );
            })
          }
        </div>
      </div>

      <!-- No Results Message -->
      <div
        x-show="isFiltering && filteredPosts.length === 0"
        class="text-center py-16"
      >
        <div class="text-slate-400 mb-4">
          <svg
            class="mx-auto h-12 w-12"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <p class="text-slate-700 dark:text-slate-300 text-lg font-semibold">
          Nenhum artigo encontrado para os filtros selecionados.
        </p>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-2 mb-6">
          Tente remover o filtro por tag ou pesquisar por outro termo técnico.
        </p>
        <button
          type="button"
          @click="clearAllFilters()"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold bg-blue-600 text-white hover:bg-blue-700 transition-colors shadow-sm cursor-pointer"
        >
          Limpar Todos os Filtros
        </button>
      </div>

      <!-- Empty State -->
      <div x-show="sortedPosts.length === 0" class="text-center py-12">
        <p class="text-slate-600 dark:text-slate-400">
          Nenhum artigo publicado no momento.
        </p>
      </div>
    </div>
  </div>
</LayoutBlog>

<script
  define:vars={{
    posts: posts.map((post) => {
      const words = (post.body || '').trim().split(/\s+/).filter(Boolean).length;
      const readingTime = Math.max(1, Math.ceil(words / 200));
      return {
        title: post.data.title,
        description: post.data.description,
        slug: post.slug,
        pubDate: post.data.pubDate.toISOString(),
        tags: post.data.tags || [],
        readingTime,
      };
    }),
    availableTags: allTags,
  }}
>
  // Blog search and tag filter functionality with Alpine.js
  document.addEventListener("alpine:init", () => {
    Alpine.data("blogSearch", () => ({
      query: "",
      selectedTag: "",
      allPosts: [],
      filteredPosts: [],
      allTagsList: [],

      get isFiltering() {
        return this.query.trim().length > 0 || this.selectedTag !== "";
      },

      init() {
        this.allPosts = posts;
        this.filteredPosts = [...this.allPosts];
        this.allTagsList = availableTags;
      },

      filterByTag(tag) {
        this.selectedTag = this.selectedTag === tag ? "" : tag;
        this.applyFilters();
      },

      search() {
        this.applyFilters();
      },

      applyFilters() {
        const q = this.query.toLowerCase().trim();
        const tag = this.selectedTag.toLowerCase().trim();

        this.filteredPosts = this.allPosts.filter((post) => {
          const matchesQuery = !q || (
            post.title.toLowerCase().includes(q) ||
            post.description.toLowerCase().includes(q) ||
            post.tags.some((t) => t.toLowerCase().includes(q))
          );

          const matchesTag = !tag || post.tags.some((t) => t.toLowerCase() === tag);

          return matchesQuery && matchesTag;
        });
      },

      clearSearch() {
        this.query = "";
        this.applyFilters();
      },

      clearAllFilters() {
        this.query = "";
        this.selectedTag = "";
        this.applyFilters();
      },

      formatDate(dateString) {
        return new Date(dateString).toLocaleDateString("pt-BR", {
          year: "numeric",
          month: "long",
          day: "numeric",
        });
      },
    }));
  });
</script>
