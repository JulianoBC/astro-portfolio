---
import LayoutBlog from "../../layouts/LayoutBlog.astro";
import PostPreview from "../../components/blog/PostPreview.astro";
import BlogFeatured from "../../components/blog/BlogFeatured.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../../config/site";

const posts = await getCollection("blog");
const featuredSlug = "arquitetura-offline-first-sqlite-outbox";

// Exclui o post em destaque da lista geral
const regularPosts = posts.filter(
  (post) => post.slug !== featuredSlug && post.id !== `${featuredSlug}.md`
);
const sortedPosts = regularPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<LayoutBlog title={`Blog - ${siteConfig.title}`}>
  <div class="px-4 sm:px-6 lg:px-8 py-8" x-data="blogSearch()" x-init="init()">
    <header class="mb-12 text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
        Blog & Artigos Técnicos
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        Explorações práticas sobre arquitetura de software, concorrência, sistemas distribuídos e engenharia de alta performance.
      </p>

      <!-- Search Component -->
      <div class="mt-8 max-w-md mx-auto">
        <div class="relative">
          <input
            type="text"
            x-model="query"
            @input="search()"
            placeholder="Buscar por tópicos, tecnologias..."
            class="w-full px-4 py-3 pl-12 pr-4 text-slate-900 dark:text-slate-100 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
          />
          <div
            class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
          >
            <svg
              class="h-5 w-5 text-slate-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <button
            x-show="query.length > 0"
            @click="clearSearch()"
            class="absolute inset-y-0 right-0 pr-3 flex items-center cursor-pointer"
          >
            <svg
              class="h-5 w-5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Search Results Counter -->
        <div
          x-show="query.length > 0"
          class="mt-2 text-sm text-slate-600 dark:text-slate-400"
        >
          <span x-text="filteredPosts.length"></span>
          <span
            x-text="filteredPosts.length === 1 ? 'artigo encontrado' : 'artigos encontrados'"
          ></span>
          <span x-show="query.length > 0"
            >para "<span x-text="query" class="font-medium"></span>"</span
          >
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto">
      <!-- Featured Post (visível quando não está buscando) -->
      <div class="mb-12" x-show="query.length === 0">
        <BlogFeatured />
      </div>

      <!-- Posts Grid - Resultados dinâmicos da busca com Alpine.js -->
      <div x-show="query.length > 0">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <template x-for="post in filteredPosts" :key="post.slug">
            <article
              class="bg-white dark:bg-slate-800 rounded-xl shadow-md overflow-hidden border border-slate-200/80 dark:border-slate-700/80 hover:shadow-lg transition-all duration-300"
            >
              <div class="p-6">
                <div
                  class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-3"
                >
                  <time x-text="formatDate(post.pubDate)"></time>
                  <span x-show="post.readingTime">•</span>
                  <span x-show="post.readingTime" class="font-medium text-emerald-600 dark:text-emerald-400" x-text="'⏱️ ' + post.readingTime + ' min'"></span>
                  <span>•</span>
                  <div class="flex gap-1.5 flex-wrap">
                    <template x-for="tag in post.tags" :key="tag">
                      <span
                        class="bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 border border-blue-200/50 dark:border-blue-800/50 px-2 py-0.5 rounded text-[11px] font-semibold"
                        x-text="'#' + tag"></span>
                    </template>
                  </div>
                </div>

                <h2
                  class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-3 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >
                  <a
                    :href="'/blog/' + post.slug"
                    x-text="post.title"></a>
                </h2>

                <p
                  class="text-slate-600 dark:text-slate-300 text-sm mb-4 line-clamp-3 leading-relaxed"
                  x-text="post.description"
                >
                </p>

                <a
                  :href="'/blog/' + post.slug"
                  class="inline-flex items-center text-sm font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300"
                >
                  Ler artigo completo
                  <svg
                    class="ml-1 w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </article>
          </template>
        </div>
      </div>

      <!-- Server-rendered posts (quando não está buscando) -->
      <div x-show="query.length === 0">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {
            sortedPosts.map((post) => {
              const words = (post.body || '').trim().split(/\s+/).filter(Boolean).length;
              const readingTime = Math.max(1, Math.ceil(words / 200));
              return (
                <PostPreview
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  tags={post.data.tags}
                  slug={post.slug}
                  readingTime={readingTime}
                />
              );
            })
          }
        </div>
      </div>

      <!-- No Results Message -->
      <div
        x-show="query.length > 0 && filteredPosts.length === 0"
        class="text-center py-12"
      >
        <div class="text-slate-400 mb-4">
          <svg
            class="mx-auto h-12 w-12"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <p class="text-slate-600 dark:text-slate-400 text-lg">
          Nenhum artigo encontrado para "<span x-text="query" class="font-medium"></span>"
        </p>
        <p class="text-slate-500 dark:text-slate-500 text-sm mt-2">
          Tente buscar por tecnologias como "Go", "SQLite", "Astro" ou "Performance".
        </p>
      </div>

      <!-- Empty State -->
      <div x-show="sortedPosts.length === 0" class="text-center py-12">
        <p class="text-slate-600 dark:text-slate-400">
          Nenhum artigo publicado no momento.
        </p>
      </div>
    </div>
  </div>
</LayoutBlog>

<script
  define:vars={{
    posts: sortedPosts.map((post) => {
      const words = (post.body || '').trim().split(/\s+/).filter(Boolean).length;
      const readingTime = Math.max(1, Math.ceil(words / 200));
      return {
        title: post.data.title,
        description: post.data.description,
        slug: post.slug,
        pubDate: post.data.pubDate.toISOString(),
        tags: post.data.tags || [],
        readingTime,
      };
    }),
  }}
>
  // Blog search functionality with Alpine.js
  document.addEventListener("alpine:init", () => {
    Alpine.data("blogSearch", () => ({
      query: "",
      allPosts: [],
      filteredPosts: [],

      init() {
        this.allPosts = posts;
        this.filteredPosts = [...this.allPosts];
      },

      search() {
        if (!this.query.trim()) {
          this.filteredPosts = [...this.allPosts];
          return;
        }

        const searchTerm = this.query.toLowerCase().trim();
        this.filteredPosts = this.allPosts.filter((post) => {
          const titleMatch = post.title.toLowerCase().includes(searchTerm);
          const descriptionMatch = post.description.toLowerCase().includes(searchTerm);
          const tagMatch = post.tags.some((tag) =>
            tag.toLowerCase().includes(searchTerm)
          );

          return titleMatch || descriptionMatch || tagMatch;
        });
      },

      clearSearch() {
        this.query = "";
        this.filteredPosts = [...this.allPosts];
      },

      formatDate(dateString) {
        return new Date(dateString).toLocaleDateString("pt-BR", {
          year: "numeric",
          month: "long",
          day: "numeric",
        });
      },
    }));
  });
</script>
