---
import Layout from "../layouts/Layout.astro";
import Header from "../components/header/Header.astro";
import { siteConfig } from "../config/site";
---

<Layout title={`404 - Página Não Encontrada | ${siteConfig.title}`}>
  <Header title={siteConfig.title} />

  <main class="min-h-[75vh] flex items-center justify-center pt-28 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full text-center">
      
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-400 border border-rose-200 dark:border-rose-800/60 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
        <span>Erro 404 • Rota Inexistente</span>
      </div>

      <!-- Grande 404 com Gradiente -->
      <h1 class="text-7xl sm:text-9xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500 tracking-tight mb-4 select-none">
        404
      </h1>

      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
        Página não encontrada
      </h2>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-lg mx-auto mb-10">
        O link que você seguiu pode estar quebrado, desatualizado ou a página pode ter sido realocada durante uma refatoração.
      </p>

      <!-- Botões de Ação -->
      <div class="flex flex-wrap gap-4 justify-center items-center">
        <a
          href="/"
          class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3.5 rounded-xl font-semibold shadow-md shadow-blue-500/25 hover:shadow-lg hover:shadow-blue-500/35 transition-all hover:-translate-y-0.5 inline-flex items-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          <span>Voltar ao Início</span>
        </a>

        <a
          href="/blog"
          class="bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60 px-6 py-3.5 rounded-xl font-semibold shadow-sm transition-all hover:-translate-y-0.5 inline-flex items-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
          </svg>
          <span>Explorar Artigos do Blog</span>
        </a>
      </div>

      <!-- Card com Sugestões Rápidas -->
      <div class="mt-16 p-6 rounded-2xl bg-white dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/80 max-w-md mx-auto text-left shadow-sm">
        <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-3">
          Atalhos Recomendados
        </p>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/blog/arquitetura-offline-first-sqlite-outbox" class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-2 font-medium">
              <span>→</span>
              <span>Arquitetura Offline-First com SQLite</span>
            </a>
          </li>
          <li>
            <a href="/blog/golang-para-microsservicos-locais" class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-2 font-medium">
              <span>→</span>
              <span>Go para Microsserviços & Concorrência</span>
            </a>
          </li>
          <li>
            <a href="/contact" class="text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-2">
              <span>→</span>
              <span>Página de Contato</span>
            </a>
          </li>
        </ul>
      </div>

    </div>
  </main>
</Layout>
