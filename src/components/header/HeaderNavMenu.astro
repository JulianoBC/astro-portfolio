---
import { siteConfig } from "../../config/site";
---
<nav class="nav-menu" x-data="{ open: false }">
  <button
    class="nav-toggle"
    aria-label="Abrir menu"
    :aria-expanded="open ? 'true' : 'false'"
    @click="open = !open"
  >
    <span class="hamburger" :class="{ 'is-active': open }"></span>
  </button>

  <ul
    class="nav-list"
    :class="{ 'open': open }"
    @click.away="open = false"
  >
    {siteConfig.navigationLinks.map(link => (
      <li>
        <a 
          href={link.path} 
          data-translate-key={`nav.${link.key}`} 
          @click="open = false"
          class="nav-item"
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>

  <!-- Backdrop escurecido no mobile -->
  <div
    class="nav-overlay"
    :class="{ 'open': open }"
    x-show="open"
    x-transition.opacity
    @click="open = false"
  ></div>
</nav>

<style>
  .nav-menu {
    position: relative;
    display: flex;
    align-items: center;
  }
  .nav-list {
    list-style: none;
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    align-items: center;
  }
  .nav-item {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s ease;
    padding: 0.5rem 0;
    position: relative;
  }
  .nav-item::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: 0;
    left: 0;
    background-color: var(--text-accent);
    transition: width 0.25s ease;
    border-radius: 9999px;
  }
  .nav-item:hover {
    color: var(--text-primary);
  }
  .nav-item:hover::after {
    width: 100%;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    z-index: 1101;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 0.5rem;
    transition: background-color 0.2s ease;
  }
  .nav-toggle:hover {
    background-color: var(--bg-hover);
  }

  .hamburger {
    width: 22px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
    position: relative;
    display: block;
    transition: all 0.3s ease;
  }
  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 22px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
    transition: all 0.3s ease;
  }
  .hamburger::before {
    top: -7px;
  }
  .hamburger::after {
    top: 7px;
  }

  .hamburger.is-active {
    background: transparent;
  }
  .hamburger.is-active::before {
    transform: rotate(45deg);
    top: 0;
  }
  .hamburger.is-active::after {
    transform: rotate(-45deg);
    top: 0;
  }

  /* Mobile Drawer */
  @media (max-width: 768px) {
    .nav-toggle {
      display: flex;
    }
    .nav-list {
      flex-direction: column;
      gap: 1.5rem;
      position: fixed;
      top: 0;
      right: -100vw;
      width: 75vw;
      max-width: 300px;
      height: 100vh;
      background: var(--bg-card);
      border-left: 1px solid var(--border-color-light);
      box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
      padding: 5rem 2rem 2rem 2rem;
      z-index: 1100;
      align-items: flex-start;
      transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .nav-list.open {
      right: 0;
    }
    .nav-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
      z-index: 1099;
    }
    .nav-overlay.open {
      display: block;
    }
  }
</style>