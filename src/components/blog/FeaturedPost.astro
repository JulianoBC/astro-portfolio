---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  url: string;
  tags: string[];
  readingTime?: number;
}

const { title, description, pubDate, url, tags, readingTime } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<div class="featured-post mb-12 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-blue-500/10 via-indigo-500/10 to-purple-500/10 border border-blue-500/20 dark:border-blue-500/30 shadow-lg shadow-blue-500/5">
  <div class="flex flex-col gap-3">
    <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-500 dark:text-slate-400">
      <span class="bg-blue-600 text-white px-2.5 py-1 rounded-md text-xs font-semibold shadow-sm">
        ★ Em destaque
      </span>
      {readingTime && (
        <span class="inline-flex items-center gap-1 bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60 px-2.5 py-0.5 rounded-md font-semibold text-xs">
          ⏱️ {readingTime} min de leitura
        </span>
      )}
      <span>•</span>
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </div>
    
    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors leading-tight">
      <a href={url}>{title}</a>
    </h2>
    
    <p class="text-slate-600 dark:text-slate-300 text-base leading-relaxed line-clamp-3 font-normal">
      {description}
    </p>
    
    <div class="flex gap-2 mt-2 flex-wrap">
      {tags.map((tag) => (
        <span class="bg-white/80 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 px-2.5 py-1 rounded-md text-xs font-medium">
          #{tag}
        </span>
      ))}
    </div>
  </div>
</div>

<style>
.featured-post {
  backdrop-filter: blur(8px);
  transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
}

.featured-post:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
}
</style>
