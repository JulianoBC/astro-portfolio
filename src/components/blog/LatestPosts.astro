---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const latestPosts = posts
  .filter((post) => post.slug !== 'arquitetura-offline-first-sqlite-outbox')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<div class="bg-white dark:bg-slate-800/80 rounded-2xl shadow-lg shadow-slate-200/50 dark:shadow-none p-6 border border-slate-200/80 dark:border-slate-700/80 backdrop-blur-sm">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
      <span>Artigos Recentes</span>
    </h2>
    <a href="/blog" class="text-blue-600 dark:text-blue-400 hover:underline text-xs font-semibold flex items-center gap-1 group">
      <span>Ver todos</span>
      <span class="transition-transform group-hover:translate-x-0.5">→</span>
    </a>
  </div>
  
  <div class="space-y-5">
    {latestPosts.map((post) => {
      const words = (post.body || '').trim().split(/\s+/).filter(Boolean).length;
      const readingTime = Math.max(1, Math.ceil(words / 200));
      return (
        <article class="border-b border-slate-100 dark:border-slate-700/60 last:border-0 pb-4 last:pb-0 group">
          <div class="flex flex-col gap-2">
            <div class="flex flex-wrap items-center gap-2">
              {post.data.tags && post.data.tags.slice(0, 2).map((tag) => (
                <span class="bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 border border-blue-200/50 dark:border-blue-800/50 text-[11px] font-semibold px-2 py-0.5 rounded">
                  #{tag}
                </span>
              ))}
              <span class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1">
                ⏱️ {readingTime} min
              </span>
            </div>
            
            <h3 class="text-base font-semibold leading-snug">
              <a href={`/blog/${post.slug}`} class="text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                {post.data.title}
              </a>
            </h3>
            
            <time datetime={post.data.pubDate.toISOString()} class="text-xs text-slate-500 dark:text-slate-400">
              {post.data.pubDate.toLocaleDateString('pt-BR', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
          </div>
        </article>
      );
    })}
  </div>
</div>
