---
import { getCollection } from "astro:content";
import FeaturedPost from "./FeaturedPost.astro";

// Get all blog posts
const posts = await getCollection("blog");

// Get the featured post (flagship architecture post or most recent)
const featuredPost = posts.find((post) => post.slug === "arquitetura-offline-first-sqlite-outbox") || posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)[0];

const postUrl = `/blog/${featuredPost.slug}`;
const wordCount = (featuredPost.body || '').trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

{featuredPost && (
  <FeaturedPost
    title={featuredPost.data.title}
    description={featuredPost.data.description}
    pubDate={featuredPost.data.pubDate}
    url={postUrl}
    tags={featuredPost.data.tags}
    readingTime={readingTime}
  />
)}
