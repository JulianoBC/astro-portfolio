---
import { siteConfig } from '../../config/site';
---

<section class="pt-32 pb-16 sm:pb-20 relative">
  <div class="hero-section-content">
    <div id="hero-bg-parallax" style="position:absolute;inset:0;z-index:0;overflow:hidden;width:100%;height:100%;pointer-events:none;">
      <canvas id="hero-particles" width="1920" height="600" style="width:100%;height:100%;display:block;"></canvas>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex flex-col items-center lg:items-start max-w-3xl">
        
        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/60 mb-6 shadow-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>Disponível para novos desafios • FullStack Developer</span>
        </div>

        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8 mb-6">
          <!-- Profile Image with Gradient Ring -->
          <div class="profile-image-container flex-shrink-0">
            <div class="profile-image">
              <img 
                src={siteConfig.profileImage}
                alt="Juliano BC"
                width="160"
                height="160"
                class="w-full h-full object-cover"
              />
            </div>
          </div>

          <div class="text-center sm:text-left">
            <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-3">
              {siteConfig.title}
            </h1>
            <div class="hero-skills-typing text-lg text-blue-600 dark:text-blue-400 font-mono font-medium min-h-[2rem] flex items-center justify-center sm:justify-start">
              <span id="typed-skill"></span><span class="typing-cursor">|</span>
            </div>
          </div>
        </div>

        <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-300 mb-8 leading-relaxed text-center lg:text-left max-w-2xl">
          <span data-translate-key="hero.subtitle">{siteConfig.description}</span>
        </p>

        <!-- Action Buttons (CTAs) -->
        <div class="flex flex-wrap gap-3.5 justify-center lg:justify-start">
          <a
            href="#about"
            class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-semibold shadow-md shadow-blue-500/20 hover:shadow-lg hover:shadow-blue-500/30 transition-all hover:-translate-y-0.5 inline-flex items-center gap-2 cursor-pointer"
          >
            <span>Sobre Mim</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>

          <a
            href="/blog"
            class="bg-white hover:bg-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700/80 text-gray-900 dark:text-white px-6 py-3 rounded-xl font-semibold border border-gray-200 dark:border-gray-700/80 shadow-sm transition-all hover:-translate-y-0.5 inline-flex items-center gap-2 cursor-pointer"
          >
            <span>Ver Artigos</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>

          <a
            href="/contact"
            class="bg-transparent hover:bg-blue-50 dark:hover:bg-blue-950/30 text-blue-600 dark:text-blue-400 px-6 py-3 rounded-xl font-semibold border border-blue-200 dark:border-blue-800/60 transition-all hover:-translate-y-0.5 inline-flex items-center gap-2 cursor-pointer"
          >
            <span>Entre em Contato</span>
          </a>
        </div>

        <!-- Social Icons -->
        <div class="mt-8 flex items-center gap-5">
          <a
            href={siteConfig.socialLinks.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-colors"
            aria-label="GitHub"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
            </svg>
          </a>

          <a
            href={siteConfig.socialLinks.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 transition-colors"
            aria-label="LinkedIn"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"/>
            </svg>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

<script type="module">
  const skills = [
    "FullStack Developer",
    "Go & Microserviços",
    "Astro & TypeScript",
    "C# & .NET",
    "RESTful APIs & SQLite",
    "Tailwind CSS & React"
  ];
  const typedSkill = document.getElementById("typed-skill");
  const cursor = document.querySelector(".typing-cursor");
  let skillIdx = 0;
  let charIdx = 0;
  let typing = true;

  function typeSkill() {
    if (!typedSkill) return;
    if (typing) {
      if (charIdx < skills[skillIdx].length) {
        typedSkill.textContent += skills[skillIdx][charIdx];
        charIdx++;
        setTimeout(typeSkill, 70);
      } else {
        typing = false;
        setTimeout(typeSkill, 1400);
      }
    } else {
      if (charIdx > 0) {
        typedSkill.textContent = skills[skillIdx].slice(0, charIdx - 1);
        charIdx--;
        setTimeout(typeSkill, 35);
      } else {
        typing = true;
        skillIdx = (skillIdx + 1) % skills.length;
        setTimeout(typeSkill, 300);
      }
    }
  }

  let cursorInterval;
  function startCursor() {
    cursorInterval = setInterval(() => {
      if (cursor) cursor.style.opacity = cursor.style.opacity === "0" ? "1" : "0";
    }, 500);
  }

  setTimeout(() => {
    typeSkill();
    startCursor();
  }, 400);

  window.addEventListener('beforeunload', () => {
    if (cursorInterval) clearInterval(cursorInterval);
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const parallax = document.getElementById('hero-bg-parallax');
    const canvas = document.getElementById('hero-particles');
    
    // Verificação de acessibilidade: respeita preferências de menos movimento
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.innerWidth <= 768;
    
    if (prefersReducedMotion || isMobile) {
      if (canvas) canvas.style.display = 'none';
      return;
    }

    if (parallax) {
      window.addEventListener('mousemove', (e) => {
        const x = (e.clientX / window.innerWidth - 0.5) * 12;
        const y = (e.clientY / window.innerHeight - 0.5) * 12;
        parallax.style.transform = `translate(${x}px, ${y}px)`;
      }, { passive: true });
    }

    if (canvas) {
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      
      const particleCount = 10;
      const particles = Array.from({ length: particleCount }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        r: 1.5 + Math.random() * 1,
        dx: (Math.random() - 0.5) * 0.4,
        dy: (Math.random() - 0.5) * 0.4,
        opacity: 0.2 + Math.random() * 0.25
      }));
      
      let lastTime = 0;
      const frameInterval = 1000 / 30; // 30 FPS cap
      let animationId;
      
      function drawParticles() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (const p of particles) {
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, 2 * Math.PI);
          ctx.fillStyle = `rgba(59, 130, 246, ${p.opacity})`;
          ctx.fill();
        }
      }
      
      function updateParticles() {
        for (const p of particles) {
          p.x += p.dx;
          p.y += p.dy;
          if (p.x < 0 || p.x > canvas.width) p.dx *= -1;
          if (p.y < 0 || p.y > canvas.height) p.dy *= -1;
        }
      }
      
      function animate(currentTime) {
        if (currentTime - lastTime >= frameInterval) {
          updateParticles();
          drawParticles();
          lastTime = currentTime;
        }
        animationId = requestAnimationFrame(animate);
      }
      
      setTimeout(() => {
        animate(0);
      }, 800);
      
      window.addEventListener('beforeunload', () => {
        if (animationId) cancelAnimationFrame(animationId);
      });
      
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          if (animationId) cancelAnimationFrame(animationId);
        } else {
          animate(performance.now());
        }
      });
    }
  });
</script>

<style>
  #hero-bg-parallax {
    pointer-events: none;
    z-index: 0;
  }
  #hero-particles {
    position: absolute;
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%;
    z-index: 0;
    opacity: 0.6;
  }
  .hero-section-content {
    position: relative;
    z-index: 1;
  }
  .hero-skills-typing {
    min-height: 2rem;
  }
  .typing-cursor {
    display: inline-block;
    width: 1ch;
    color: #2563eb;
    font-weight: bold;
    margin-left: 2px;
  }

  .profile-image-container {
    position: relative;
    padding: 3px;
    border-radius: 9999px;
    background: linear-gradient(135deg, #2563eb, #38bdf8, #6366f1);
    box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.25);
  }

  .profile-image {
    width: 130px;
    height: 130px;
    border-radius: 9999px;
    overflow: hidden;
    background: var(--bg-card);
    border: 3px solid var(--bg-card);
    transition: transform 0.3s ease;
  }

  .profile-image:hover {
    transform: scale(1.03);
  }

  .profile-image img {
    transition: transform 0.4s ease;
  }

  .profile-image:hover img {
    transform: scale(1.08);
  }

  @media (max-width: 640px) {
    .profile-image {
      width: 110px;
      height: 110px;
    }
  }
</style>