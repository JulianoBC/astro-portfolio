---
interface Props {
  title?: string;
  id?: string;
}

const { 
  title = "Sobre Mim",
  id = "about"
} = Astro.props;

const skillCategories = [
  {
    category: "Frontend & Interface",
    icon: `<svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
    skills: [
      "Astro 5",
      "TypeScript",
      "Tailwind CSS",
      "React",
      "Next.js",
      "Alpine.js",
      "HTML5 & CSS3"
    ]
  },
  {
    category: "Backend & Microsserviços",
    icon: `<svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>`,
    skills: [
      "Go (Golang)",
      "C# (.NET)",
      "Node.js & Express",
      "RESTful APIs",
      "Clean Architecture",
      "Concorrência & Goroutines"
    ]
  },
  {
    category: "Bancos de Dados & Resiliência",
    icon: `<svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg>`,
    skills: [
      "SQLite (WAL Mode)",
      "PostgreSQL (Neon)",
      "MongoDB",
      "Padrão Outbox",
      "Otimização Anti N+1"
    ]
  },
  {
    category: "Desktop, DevOps & Ferramentas",
    icon: `<svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    skills: [
      "Wails (Go + Web)",
      "Docker",
      "Git & GitHub Actions",
      "CI/CD & Vercel",
      "PowerShell & Linux"
    ]
  }
];
---

<section class="about-section py-20 relative overflow-hidden" id={id}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header da Seção -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-400 border border-blue-200 dark:border-blue-800/60 mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
        <span>Experiência Comprovada • 4+ Anos</span>
      </div>
      
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-4">
        {title}
      </h2>
      <div class="w-16 h-1 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-full mx-auto"></div>
    </div>
    
    <!-- Conteúdo da Bio -->
    <div class="max-w-4xl mx-auto mb-16">
      <div class="bg-white dark:bg-slate-800/80 rounded-2xl p-6 sm:p-10 shadow-lg shadow-slate-200/50 dark:shadow-none border border-slate-200/80 dark:border-slate-700/80 backdrop-blur-sm">
        <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed mb-6 font-normal">
          Com <strong>mais de 4 anos de experiência</strong> em desenvolvimento de software fullstack, atuo no ciclo completo de desenvolvimento de aplicações — desde a concepção de arquiteturas resilientes e APIs de alto rendimento até interfaces modernas e intuitivas. Minha prática é pautada por código limpo, tipagem estrita e sistemas escaláveis.
        </p>
        <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed mb-8 font-normal">
          Advogo para tecnologias diretas e eficientes: microsserviços e daemons em <strong>Go</strong>, ecossistema corporativo com <strong>C# (.NET)</strong>, arquiteturas <em>Offline-First</em> com <strong>SQLite</strong> e nuvem, além de interfaces ultravelozes com <strong>Astro</strong>, <strong>TypeScript</strong> e <strong>Tailwind CSS</strong>. Meu foco é transformar desafios técnicos complexos em produtos estáveis, rápidos e de alto valor.
        </p>

        <!-- Indicadores de Destaque -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-slate-100 dark:border-slate-700/60">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/50 flex items-center justify-center text-blue-600 dark:text-blue-400 font-bold text-lg border border-blue-100 dark:border-blue-900/50">
              4+
            </div>
            <div>
              <p class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider font-semibold">Carreira</p>
              <p class="text-sm font-bold text-slate-900 dark:text-slate-100">Anos de Experiência</p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/50 flex items-center justify-center text-indigo-600 dark:text-indigo-400 font-bold text-lg border border-indigo-100 dark:border-indigo-900/50">
              ⚡
            </div>
            <div>
              <p class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider font-semibold">Filosofia</p>
              <p class="text-sm font-bold text-slate-900 dark:text-slate-100">Performance & Limpeza</p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 flex items-center justify-center text-emerald-600 dark:text-emerald-400 font-bold text-lg border border-emerald-100 dark:border-emerald-900/50">
              🛡️
            </div>
            <div>
              <p class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider font-semibold">Arquitetura</p>
              <p class="text-sm font-bold text-slate-900 dark:text-slate-100">Offline-First & Nuvem</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Grid de Habilidades Técnicas -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {skillCategories.map((group) => (
        <div class="bg-white dark:bg-slate-800/70 rounded-xl p-6 shadow-md shadow-slate-200/30 dark:shadow-none border border-slate-200/80 dark:border-slate-700/80 hover:border-blue-400 dark:hover:border-blue-500/50 transition-all duration-300 hover:-translate-y-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-700/50 border border-slate-100 dark:border-slate-700" set:html={group.icon}></div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">
              {group.category}
            </h3>
          </div>

          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <span class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-700/60 text-slate-800 dark:text-slate-200 border border-slate-200/60 dark:border-slate-600/60 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:text-blue-600 dark:hover:text-blue-400 hover:border-blue-300 dark:hover:border-blue-800/80 transition-colors">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
